        <mxCell id="mowYaQl9vmWRMdCl8GRS-45" value="&lt;div&gt;&amp;nbsp; 必须对数据库名、表名、字段名、别名外层加反引号（`）。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;shape=mxgraph.basic.document;fillColor=#FFFFFF;" vertex="1" parent="1">
